{
  "name": "marketplace-scout",
  "productName": "Clynx",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop app that watches Facebook Marketplace searches, screens listings with AI against your reference prices, and alerts you to deals.",
  "main": "./out/main/index.js",
  "build": {
    "appId": "com.clynx.app",
    "productName": "Clynx",
    "win": {
      "icon": "build/icon.ico"
    }
  },
  "scripts": {
    "postinstall": "playwright install chromium",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "^1.49.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
