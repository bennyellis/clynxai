# Local website preview (never used in production). Copy to .env.preview and run:  npm run preview:web
# A SEPARATE database and Redis database number keep it apart from the development stack.
DATABASE_URL=postgres://clynx:clynx_dev_password@localhost:5432/clynx_web_preview
REDIS_URL=redis://localhost:6379/5
PORT=8790
PUBLIC_URL=http://localhost:8790
COOKIE_SECURE=false
JWT_ACCESS_SECRET=preview-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=preview-refresh-secret-change-me-0123456789
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the stored provider credentials.
CREDENTIALS_ENCRYPTION_KEY=
# The simulated payment provider: NO Stripe, no money. Refused when NODE_ENV=production.
BILLING_FAKE=true
STRIPE_PRICE_PRO_MONTHLY=price_preview_monthly
STRIPE_PRICE_PRO_YEARLY=price_preview_yearly
WEBSITE_DIR=../website/dist
RELEASES_DIR=./data/preview-releases
# Prices are NOT set: the website shows a placeholder until the owner approves plans.
# PLAN_PRICE_PRO_MONTHLY_DISPLAY=
# PLAN_PRICE_PRO_YEARLY_DISPLAY=
