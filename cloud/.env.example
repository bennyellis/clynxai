# Copy this file to .env (and, for running tests, to .env.test with a
# separate database name) and fill in real values. Never commit the real
# .env file.

# Postgres connection string. docker-compose.yml's defaults match this.
DATABASE_URL=postgres://clynx:clynx_dev_password@localhost:5432/clynx_cloud

# Secrets used to sign JWTs. Use long, random, unrelated values for each —
# e.g. `openssl rand -hex 32`. Never reuse these placeholders in production.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-for-access-tokens
JWT_REFRESH_SECRET=replace-with-a-long-random-secret-for-refresh-tokens

# Port the Fastify server listens on.
PORT=8787

# Redis connection string, used by the BullMQ job queue (Phase 4). Redis DBs
# are cheap/ephemeral — tests can share the same instance dev uses.
REDIS_URL=redis://localhost:6379

# Shared OpenAI key for the /ai/* proxy routes — every authenticated desktop
# user's AI calls (chat, scoring, vision, product research) route through
# this server and use THIS key, so it never has to live on any client
# machine. Every request is metered per user; daily quotas by plan apply when
# ENFORCE_ENTITLEMENTS=true (see ai/routes.ts and entitlements/plans.ts).
# OPTIONAL fallback: normally the Owner saves the key in the website console (stored encrypted, see CREDENTIALS_ENCRYPTION_KEY below).
# OPENAI_API_KEY=

# ---- Phase 5/6 settings (all optional) --------------------------------------
# Only these models are forwarded by the AI proxy (comma separated).
# AI_ALLOWED_MODELS=gpt-5-mini,gpt-5,gpt-4.1-mini,gpt-4.1,gpt-4o-mini,gpt-4o,gpt-image-1
# AI_MAX_OUTPUT_TOKENS=32000
# Web search for product research through OpenAI (POST /ai/search): OFF by default. Each search carries a per-search provider fee on top of tokens; check OpenAI's price list and set
# AI_SEARCH_FEE_USD to match (the default 0.03 is only an estimate used for budgets). The model must support the web search tool and be in AI_ALLOWED_MODELS.
# AI_SEARCH_ENABLED=false
# AI_SEARCH_MODEL=gpt-4.1-mini
# AI_SEARCH_FEE_USD=0.03
# AI_SEARCH_MAX_OUTPUT_TOKENS=600

# Staged activation: plan limits (watches, devices, AI per day) are refused only
# when this is true. Usage is metered either way.
ENFORCE_ENTITLEMENTS=false

# true when the API sits behind a reverse proxy / load balancer (so rate limits
# use the real client IP). Leave false when the API is exposed directly.
TRUST_PROXY=false

# Enables GET /metrics for a monitoring system (sent as a bearer token).
# METRICS_TOKEN=replace-with-at-least-16-random-characters

# Rate limits (per client IP). Defaults are shown.
# RATE_LIMIT_LOGIN_FAILS=8
# RATE_LIMIT_REGISTER_PER_HOUR=20

# Billing (Stripe). Leave blank to run without billing: everyone stays on their
# base plan and the billing endpoints answer "billing_not_configured".
# Use TEST-mode keys until you deliberately go live. See DEPLOYMENT.md.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# BILLING_SUCCESS_URL=https://your-site.example/billing/success
# BILLING_CANCEL_URL=https://your-site.example/billing/cancel
# BILLING_RETURN_URL=https://your-site.example/billing/return
# TRIAL_DAYS=7
# PAST_DUE_GRACE_DAYS=7

# ---- Phase 10: website, accounts and company-managed integrations -------------------
# The public address of the website. In production it is the https address; cookies get the Secure flag automatically when this is https.
# PUBLIC_URL=http://localhost:8787
# COOKIE_SECURE=            # "true"/"false" to override; unset = Secure exactly when PUBLIC_URL is https
# SESSION_TTL_DAYS=14
# Outgoing email (verification, password reset). Without SMTP_URL emails are only recorded in the outbox and nothing is sent.
# SMTP_URL=smtps://user:password@smtp.your-provider.example:465
# MAIL_FROM="Clynx <no-reply@your-domain.example>"
# SUPPORT_EMAIL=support@your-domain.example
# Built website (website/dist) and where uploaded installers are kept.
# WEBSITE_DIR=../website/dist
# RELEASES_DIR=./data/releases
# Text shown on the Pricing page. Unset = a clearly marked placeholder (no price is invented).
# PLAN_PRICE_PRO_MONTHLY_DISPLAY=
# PLAN_PRICE_PRO_YEARLY_DISPLAY=
# REQUIRE_VERIFIED_EMAIL_FOR_BILLING=false
# DEVELOPMENT ONLY: simulated Stripe pages for local testing. Refused when NODE_ENV=production.
# BILLING_FAKE=true
#
# Company-managed OpenAI and eBay credentials are saved by the Owner in the website console and stored ENCRYPTED in the database with this key
# (32 random bytes, base64:  openssl rand -base64 32). Losing it makes the stored credentials unreadable, so back it up separately from the database.
# CREDENTIALS_ENCRYPTION_KEY=
# To rotate: put the old key here, the new key above, restart, then re-save each credential in the console.
# CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=
# eBay application credentials may also come from the environment as a FALLBACK for a server where none were ever saved in the console.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_ENV=SANDBOX          # SANDBOX or PRODUCTION (default PRODUCTION)
# EBAY_RUNAME=              # the redirect name eBay assigns, needed for customers connecting their own eBay account
# Price table override (USD per million tokens) for the estimated-cost accounting.
# AI_PRICES_JSON=
