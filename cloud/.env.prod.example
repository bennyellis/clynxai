# Copy to .env.prod and fill in. Never commit .env.prod. Generate secrets with:  openssl rand -hex 32
POSTGRES_USER=clynx
POSTGRES_PASSWORD=
POSTGRES_DB=clynx_cloud
REDIS_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# The https address customers use (the website and the API are the same address). Required for correct emails, cookies and the same-origin check.
PUBLIC_URL=https://your-domain.example
# Vault key for the company's stored OpenAI/eBay credentials:  openssl rand -base64 32   (BACK IT UP separately from the database)
CREDENTIALS_ENCRYPTION_KEY=
# Outgoing email (verification and password reset). Leave blank and nothing is sent.
SMTP_URL=
MAIL_FROM=Clynx <no-reply@your-domain.example>
SUPPORT_EMAIL=support@your-domain.example
# OPTIONAL fallback: normally the Owner saves the OpenAI key in the website console (stored encrypted). Leave blank.
OPENAI_API_KEY=
ENFORCE_ENTITLEMENTS=false
METRICS_TOKEN=
# Pricing page text. Leave blank until the prices are decided (the page shows a placeholder).
PLAN_PRICE_PRO_MONTHLY_DISPLAY=
PLAN_PRICE_PRO_YEARLY_DISPLAY=
REQUIRE_VERIFIED_EMAIL_FOR_BILLING=false
# Billing: leave blank until you have created a Stripe account and products (TEST mode first). See DEPLOYMENT.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Where Stripe returns customers. Leave blank to use the website's own subscription page (recommended).
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
BILLING_RETURN_URL=
