GROQ_API_KEY=gsk_...
# Optional override if the default model gets deprecated on Groq's end —
# see https://console.groq.com/docs/models, or GET /openai/v1/models with
# your key, for what's currently available.
# GROQ_MODEL=openai/gpt-oss-20b

# Optional — only needed for photo analysis (Config → Gemini API key).
# Free key, no card required, from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.6-flash

# Optional — only needed to turn on eBay scanning (Config → eBay Marketplace).
# Free eBay Developer Program account, Production keyset (Sandbox search
# only returns mock data, not real listings), from https://developer.ebay.com
EBAY_CLIENT_ID=...
EBAY_CLIENT_SECRET=...

# Optional (Beta 14) - better web research. Clynx researches products it is unsure about (storage sizes, look-alike models) by searching the web.
# With none of these set it uses DuckDuckGo and Bing, which need no key. Set one for steadier results; Google is used first, then Brave, then the free engines.
# Google Programmable Search (free: 100 searches a day). Create a search engine set to "Search the entire web" at https://programmablesearchengine.google.com
# and an API key at https://console.cloud.google.com (enable "Custom Search API").
# GOOGLE_CSE_API_KEY=...
# GOOGLE_CSE_ID=...
# GOOGLE_CSE_DAILY_LIMIT=90
# Brave Search API (free plan with a monthly allowance): https://api.search.brave.com
# BRAVE_SEARCH_API_KEY=...
