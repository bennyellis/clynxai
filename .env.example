GROQ_API_KEY=gsk_...
# Optional override if the default model gets deprecated on Groq's end —
# see https://console.groq.com/docs/models, or GET /openai/v1/models with
# your key, for what's currently available.
# GROQ_MODEL=openai/gpt-oss-20b

# Optional — only needed for photo analysis (Config → Gemini API key).
# Free key, no card required, from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.6-flash

# Optional — only needed to turn on eBay scanning (Config → eBay Marketplace).
# Free eBay Developer Program account, Production keyset (Sandbox search
# only returns mock data, not real listings), from https://developer.ebay.com
EBAY_CLIENT_ID=...
EBAY_CLIENT_SECRET=...
