node_modules/
out/
dist/
data/
browser-profile/
browser-profiles/
ebay-profile/
.env
config.json
*.log

# Per-install login/session state (holds a refresh token) — never commit
cloud-session.json
app-settings.json

# Last-known-good copies and kept-aside damaged files written by safeFs.ts / dbIntegrity.ts (can hold keys or tokens)
*.bak
*.corrupt-*
*.before-restore-*
*.unreadable-*
*.tmp-*
*.recover-requested

audit/phase4_shadow/run.cjs
audit/phase4_repro/*.cjs
audit/phase4_shadow/doubt_rule_check.cjs
audit/phase4_shadow/protection_check.cjs
audit/phase4_shadow/bench_10k.cjs
audit/phase4_shadow/migration_test.cjs
audit/phase4_shadow/open_timing.cjs

# Generated bundles of the read-only audit tools (built by audit/phase4_shadow/build.cjs; not kept in git)
audit/phase4_shadow/*.cjs
!audit/phase4_shadow/build.cjs
*.restore-requested
*.restoring
*.partial
resources/build-info.json
beta-release/

# Backup copies of .env made when saved API keys are protected (may hold the old plain-text keys)
.env.backup-*
